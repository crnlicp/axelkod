   locked;
   open;
 };
type FiscalYear = 
 record {
   end: Date;
   id: nat;
   lockedAt: opt Time;
   start: Date;
   status: FiscalYearStatus;
 };
type FeeCategory = 
 variant {
   full;
   none;
   pension;
   youth;
 };
type EslRow = 
 record {
   buyer: text;
   goods: int;
   services: int;
   triangulation: int;
   vatNr: text;
 };
type EslPreview = 
 record {
   filed: opt EcSalesList;
   from: Date;
   missingVatNr: nat;
   rows: vec EslRow;
   to: Date;
 };
type EslFileInput = 
 record {
   contactName: text;
   email: opt text;
   from: Date;
   phone: text;
   receiptRef: opt text;
   to: Date;
 };
type Error = 
 variant {
   conflict: text;
   invalid: text;
   keys: text;
   lastOwner;
   locked: text;
   notAuthorized;
   notFound;
   vault: text;
 };
type EmployeeInput = 
 record {
   active: bool;
   addressEnc: opt blob;
   bankAccountEnc: opt blob;
   birthYear: nat;
   costCenter: opt text;
   email: opt text;
   employedFrom: Date;
   employedTo: opt Date;
   jamkning: opt text;
   name: text;
   ownerOrRelated: bool;
   pay: Pay;
   personnummerEnc: blob;
   tax: Tax;
   vacationDays: nat;
   vacationRule: VacationRule;
   vaxaFrom: opt text;
   workplaceCity: opt text;
   workplaceStreet: opt text;
 };
type Employee = 
 record {
   active: bool;
   addressEnc: opt blob;
   bankAccountEnc: opt blob;
   birthYear: nat;
   costCenter: opt text;
   email: opt text;
   employedFrom: Date;
   employedTo: opt Date;
   id: nat;
   jamkning: opt text;
   name: text;
   ownerOrRelated: bool;
   pay: Pay;
   personnummerEnc: blob;
   tax: Tax;
   vacationDays: nat;
   vacationRule: VacationRule;
   vaxaFrom: opt text;
   workplaceCity: opt text;
   workplaceStreet: opt text;
 };
type EcSalesList = 
 record {
   contactName: text;
   email: opt text;
   filedAt: Time;
   filedBy: principal;
   from: Date;
   id: nat;
   phone: text;
   receiptRef: opt text;
   rows: vec EslRow;
   to: Date;
 };
type DocView = 
 record {
   balance: Money;
   credited: Money;
   credits: vec nat;
   doc: SalesDoc;
   invoices: vec nat;
   overdue: bool;
   paid: Money;
   payments: vec Payment;
   reminders: vec nat;
   status: DocStatus;
 };
type DocSummary = 
 record {
   balance: Money;
   currency: text;
   customerName: text;
   dueDate: opt Date;
   id: nat;
   issueDate: Date;
   kind: DocKind;
   number: nat;
   status: DocStatus;
   total: Money;
 };
type DocStatus = 
 variant {
   credited;
   issued;
   overdue;
   paid;
   partiallyPaid;
   quote: QuoteStatus;
 };
type DocLine = 
 record {
   account: nat;
   description: text;
   discountBp: nat;
   itemId: opt nat;
   quantity: int;
   unit: text;
   unitPrice: Money;
   vatCode: text;
 };
type DocKind = 
 variant {
   creditNote;
   invoice;
   quote;
 };
type DocInput = 
 record {
   currency: text;
   customerId: nat;
   deliveryDate: opt Date;
   fxRate: opt FxRate;
   language: Lang;
   lines: vec DocLine;
   notes: opt text;
   ourRef: opt text;
   termsDays: nat;
   validUntil: opt Date;
   yourRef: opt text;
 };
type Date = text;
type CustomerInput = 
 record {
   active: bool;
   address: Address;
   email: opt text;
   kind: variant {
           company;
           person;
         };
   language: Lang;
   name: text;
   orgNr: opt text;
   peppolId: opt text;
   reminderFeeAgreed: bool;
   termsDays: nat;
   vatNr: opt text;
 };
type Customer = 
 record {
   active: bool;
   address: Address;
   email: opt text;
   id: nat;
   kind: variant {
           company;
           person;
         };
   language: Lang;
   name: text;
   orgNr: opt text;
   peppolId: opt text;
   reminderFeeAgreed: bool;
   termsDays: nat;
   vatNr: opt text;
 };
type CsvMapping = 
 record {
   amountCol: nat;
   counterpartyCol: opt nat;
   dateCol: nat;
   decimalComma: bool;
   delimiter: text;
   referenceCol: opt nat;
   skipRows: nat;
   textCol: nat;
 };
type CompanyProfile = 
 record {
   bankgiro: opt text;
   bic: opt text;
   city: text;
   country: text;
   email: text;
   fSkatt: bool;
   iban: opt text;
   legalName: text;
   orgNr: text;
   peppolId: opt text;
   phone: opt text;
   plusgiro: opt text;
   postalCode: text;
   registeredOffice: text;
   street: text;
   vatNr: text;
   web: opt text;
 };
type Box = 
 record {
   amount: int;
   box: nat;
 };
type BankTx = 
 record {
   accountId: nat;
   amount: Money;
   batch: nat;
   counterparty: opt text;
   date: Date;
   id: nat;
   match: opt record {
                at: Time;
                by: principal;
                kind: Match;
                voucherId: nat;
              };
   reference: opt text;
   "text": text;
 };
type BankAccountInput = 
 record {
   bank: text;
   ledgerAccount: nat;
   mapping: opt CsvMapping;
   name: text;
 };
type BankAccount = 
 record {
   bank: text;
   id: nat;
   ledgerAccount: nat;
   mapping: opt CsvMapping;
   name: text;
 };
type BalanceRow = 
 record {
   account: nat;
   months: vec int;
 };
type AuditEntry = 
 record {
   action: text;
   at: Time;
   detailHash: blob;
   entity: text;
   entityId: opt nat;
   hash: blob;
   prevHash: blob;
   "principal": principal;
   seq: nat;
 };
type AttachmentMeta = 
 record {
   filename: text;
   keyId: text;
   mime: text;
   plainSha256: blob;
   receivedVia: variant {
                  email;
                  scan;
                  upload;
                };
   size: nat;
   wrappedKey: blob;
 };
type Attachment = 
 record {
   cipherSha256: blob;
   filename: text;
   id: nat;
   keyId: text;
   mime: text;
   plainSha256: blob;
   receivedVia: variant {
                  email;
                  scan;
                  upload;
                };
   size: nat;
   uploadedAt: Time;
   uploadedBy: principal;
   vaultFileId: nat;
   wrappedKey: blob;
 };
type AgiReturn = 
 record {
   createdAt: Time;
   createdBy: principal;
   filedAt: opt Time;
   id: nat;
   individuals: vec AgiIndividual;
   period: text;
   receiptRef: opt text;
   runIds: vec nat;
   sumFees: int;
   sumTax: int;
 };
type AgiIndividual = 
 record {
   employeeId: nat;
   fields: vec AgiField;
   specNr: nat;
 };
type AgiField = 
 record {
   amount: int;
   code: nat;
 };
type Address = 
 record {
   city: text;
   country: text;
   postalCode: text;
   street: text;
 };
type AccountingSettings = 
 record {
   accountingMethod: variant {
                       cash;
                       invoice;
                     };
   defaultLanguage: variant {
                      en;
                      sv;
                    };
   invoiceTermsDays: nat;
   modules: Modules;
   storageNotice: opt StorageNotice;
   vatPeriod: variant {
                month;
                quarter;
                year;
              };
 };
type Accounting = 
 service {
   /// Huvudbok input: the vouchers that touch one account, in registration order.
   accountVouchers: (fiscalYearId: nat, account: nat, offset: nat, limit:
    nat) -> (Result_58) query;
   addAccount: (number: nat, name: text, vatCode: opt text, sruCode:
    opt text) -> (Result_3);
   /// Recalculates with today's parameters and tables, posts series P and freezes the run.
   approvePayRun: (id: nat) -> (Result_14);
   /// The audit trail of one record (e.g. "voucher", id), oldest first.
   auditFor: (entity: text, id: nat) -> (Result_77) query;
   auditLog: (offset: nat, limit: nat) -> (Result_76) query;
   /// Net amount per account and month: the trial balance and reports read this.
   balances: (fiscalYearId: nat) -> (Result_75) query;
   beginAttachment: (meta: AttachmentMeta) -> (Result_74);
   /// Books a transaction with a rule or with counter lines that balance the bank line.
   bookBankTx: (txId: nat, ruleId: opt nat, counter: vec VoucherLine,
    description: text) -> (Result_27);
   /// Books a received document in one update: checks, takes the L number, posts the
   /// voucher with the original file attached. Under the cash method supplier invoices
   /// and credit notes are registered now and booked at payment.
   bookPurchase: (x: PurchaseInput) -> (Result_65);
   /// Books an entry against 1630. `account` is required for #other and ignored otherwise.
   bookTaxEntry: (id: nat, account: opt nat) -> (Result_8);
   /// Checks a VAT number in VIES (HTTPS outcall from one node) and stores the answer.
   checkVatNumber: (vatNr: text) -> (Result_73);
   confirmAttachment: (ticket: nat, vaultFileId: nat) -> (Result_69);
   /// A correction voucher in series C that references the original (5 kap. 5 §).
   /// `lines = null` reverses the original in full.
   correctVoucher: (id: nat, eventDate: Date, description: text, lines:
    opt vec VoucherLine) -> (Result_25);
   /// Builds the return for a period from its approved runs (none: a zero return).
   createAgiReturn: (period: text) -> (Result_29);
   createFiscalYear: (start: Date, end: Date, changeover: bool) ->
    (Result_10);
   /// A payment reminder for an overdue invoice. B2B: förseningsersättning once (1981:739 4 a §),
   /// and then no reminder fee (5 §). Otherwise the agreed reminder fee (2 §). Interest from the
   /// due date at the reference rate + 8 pp (Räntelagen 3, 6 §§); it is claimed, not booked.
   createReminder: (invoiceId: nat, date: Date) -> (Result_72);
   /// One month for one employee, after the AGI for the period is filed (V9).
   createVaxa: (period: text, employeeId: nat) -> (Result_7);
   /// A credit note draft with the invoice's lines; edit it for a partial credit.
   creditDraftFrom: (invoiceId: nat) -> (Result_13);
   /// Rules are settings, not accounting records, so they may be removed (audited).
   deleteBankRule: (id: nat) -> (Result_5);
   deleteDraft: (id: nat) -> (Result_5);
   deletePayRun: (id: nat) -> (Result_5);
   deleteSalesDraft: (id: nat) -> (Result_5);
   /// The vetKey for `purpose`, encrypted to the caller's transport key.
   deriveKey: (purpose: text, transportPublicKey: blob) -> (Result);
   ecSalesPreview: (from: Date, to: Date) -> (Result_71) query;
   /// Freezes the rows that were filed, with the contact details printed on the file.
   fileEcSalesList: (x: EslFileInput) -> (Result_70);
   getAttachment: (id: nat) -> (Result_69) query;
   getCompany: () -> (Result_68) query;
   getParameters: () -> (Result_67) query;
   getPayRun: (id: nat) -> (Result_14) query;
   getPayrollParams: () -> (Result_66) query;
   getPurchase: (id: nat) -> (Result_65) query;
   getSalesDoc: (id: nat) -> (Result_59) query;
   getSettings: () -> (Result_64) query;
   getVatCheck: (vatNr: text) -> (Result_63) query;
   getVoucher: (id: nat) -> (Result_62) query;
   /// Adds rows to an account; a row already imported (same date, amount, text and
   /// reference, and the same ordinal among identical rows) is skipped.
   importBankRows: (accountId: nat, rows: vec Row) -> (Result_61);
   importTaxRows: (rows: vec TaxRow) -> (Result_61);
   /// One table of one year, parsed in the browser from Skatteverket's file; `sha256` is the file's.
   importTaxTable: (year: nat, table: nat, rows: vec TaxTableRow, sha256:
    blob) -> (Result_60);
   invoiceDraftFromQuote: (quoteId: nat) -> (Result_13);
   issueSalesDraft: (id: nat) -> (Result_59);
   /// Grundbok: registration order, optionally one series.
   journal: (fiscalYearId: nat, series: opt text, offset: nat, limit: 
    nat) -> (Result_58) query;
   /// Links a document to a voucher after posting (the voucher itself stays unchanged).
   linkAttachment: (attachmentId: nat, voucherId: nat) -> (Result_5);
   /// Links a transaction to a voucher that already has the same amount on the bank account.
   linkBankTx: (txId: nat, voucherId: nat) -> (Result_27);
   /// Links a payment or refund to the voucher that has the same amount on 1630.
   linkTaxEntry: (id: nat, voucherId: nat) -> (Result_8);
   /// Links the booked tax-account VAT entry (the amount on box 49, debited or credited).
   linkVatPayment: (id: nat, taxEntryId: nat) -> (Result_28);
   listAccounts: () -> (Result_57) query;
   listAgiReturns: () -> (Result_56) query;
   /// Newest first.
   listAttachments: (offset: nat, limit: nat) -> (Result_55) query;
   listBankAccounts: () -> (Result_54) query;
   listBankRules: () -> (Result_53) query;
   listBankTxs: (accountId: opt nat, unmatchedOnly: bool, offset: nat, limit:
    nat) -> (Result_52) query;
   listCustomers: () -> (Result_51) query;
   listDrafts: () -> (Result_50) query;
   listEcSalesLists: () -> (Result_49) query;
   listEmployees: () -> (Result_48) query;
   listFiscalYears: () -> (Result_47) query;
   /// Received files not yet used as evidence ("Att bokföra"), newest first.
   listInbox: () -> (Result_46) query;
   listItems: () -> (Result_45) query;
   listPayItems: () -> (Result_44) query;
   listPayRuns: () -> (Result_43) query;
   listPayments: (offset: nat, limit: nat) -> (Result_42) query;
   listPurchases: (kinds: vec PurchaseKind, offset: nat, limit: nat) ->
    (Result_41) query;
   listReminders: (offset: nat, limit: nat) -> (Result_40) query;
   listRoles: () -> (Result_39) query;
   listSalesDocs: (kind: opt DocKind, offset: nat, limit: nat) ->
    (Result_38) query;
   listSalesDrafts: () -> (Result_37) query;
   listSeries: () -> (Result_36) query;
   listSuppliers: () -> (Result_35) query;
   listTaxEntries: (offset: nat, limit: nat) -> (Result_34) query;
   listTaxTables: () -> (Result_33) query;
   listVatCodes: () -> (Result_32) query;
   listVatReturns: () -> (Result_31) query;
   listVaxa: () -> (Result_30) query;
   /// Locks the period in one update: stores the boxes and the source hash, posts the
   /// settlement voucher (series M, dated the last day) and moves the lock date there.
   lockVatReturn: (from: Date, to: Date, note: opt text) -> (Result_28);
   markAgiFiled: (id: nat, receiptRef: opt text) -> (Result_29);
   /// Net pay leaves the bank account (series B, 2820 → 1930).
   markPayRunPaid: (id: nat, date: Date) -> (Result_14);
   /// Records that the return was submitted in Skatteverket's e-service.
   markVatReturnFiled: (id: nat, receiptRef: opt text) -> (Result_28);
   /// A deposit pays an invoice. `amount` is in the invoice currency (only needed for
   /// foreign-currency invoices; SEK invoices take the whole deposit).
   matchBankToInvoice: (txId: nat, salesDocId: nat, amount: opt Money) ->
    (Result_27);
   /// A withdrawal pays a supplier invoice or an expense claim.
   matchBankToPurchase: (txId: nat, purchaseId: nat, amount: opt Money) ->
    (Result_27);
   me: () -> (Me) query;
   /// Pays a supplier invoice or an expense claim from the bank (1930). Bank matching
   /// uses the same posting with the matched bank account.
   paySupplier: (p: PayInput) -> (Result_26);
   postDraft: (id: nat) -> (Result_25);
   postVoucher: (v: VoucherInput) -> (Result_25);
   /// The document as it would be issued today (totals, notes, OCR), without taking a number.
   previewSalesDraft: (id: nat) -> (Result_24) query;
   registerPayment: (p: PaymentInput) -> (Result_23);
   removeRole: (p: principal) -> (Result_9);
   saveBankAccount: (id: opt nat, a: BankAccountInput) -> (Result_21);
   saveBankRule: (id: opt nat, r: RuleInput) -> (Result_20);
   /// Creates (id = null) or updates a customer. Issued documents keep their own snapshot.
   saveCustomer: (id: opt nat, c: CustomerInput) -> (Result_19);
   /// Creates (id = null) or replaces a draft. Only sizes are checked here; the
   /// full rules run when it is posted.
   saveDraft: (id: opt nat, v: VoucherInput) -> (Result_18);
   saveEmployee: (id: opt nat, e: EmployeeInput) -> (Result_17);
   saveItem: (id: opt nat, i: ItemInput) -> (Result_16);
   savePayItem: (i: PayItem) -> (Result_15);
   /// Saves a draft and calculates every payslip. The period is the payment month (AGI).
   savePayRun: (id: opt nat, paymentDate: Date, inputs: vec SlipInput) ->
    (Result_14);
   saveSalesDraft: (id: opt nat, kind: DocKind, input: DocInput, creditOf:
    opt nat, quoteOf: opt nat) -> (Result_13);
   saveSupplier: (id: opt nat, s: SupplierInput) -> (Result_12);
   setCompany: (c: CompanyProfile) -> (Result_11);
   setFiscalYearStatus: (id: nat, status: FiscalYearStatus) -> (Result_10);
   /// Moves the lock date forward (never back), up to today.
   setLockDate: (date: Date) -> (Result_5);
   /// Owner only; every change is audited with its source.
   setParameters: (p: Parameters) -> (Result_5);
   /// Owner only, audited with its source (rates are legal data, V8–V11).
   setPayrollParams: (p: Params) -> (Result_5);
   setQuoteStatus: (id: nat, status: variant {
                                       accepted;
                                       declined;
                                     }) -> (Result_5);
   setRole: (p: principal, role: Role) -> (Result_9);
   setSettings: (s: AccountingSettings) -> (Result_5);
   /// Corrects the kind of an entry that is not booked yet.
   setTaxKind: (id: nat, kind: TaxKind) -> (Result_8);
   setVaxaStatus: (id: nat, status: VaxaStatus) -> (Result_7);
   /// Called by the admin UI after sign-in so logins appear in the audit log.
   signIn: () -> (Me);
   suggestBankMatches: (txId: nat) -> (Result_6) query;
   /// Repairs the vault's copy, e.g. after a vault reinstall.
   syncRolesToVault: () -> (Result_5);
   /// Imported balance against the 1630 ledger balance (all fiscal years).
   taxAccountSummary: () -> (Result_4) query;
   /// The number and kind never change; vouchers refer to the number.
   updateAccount: (number: nat, name: text, vatCode: opt text, sruCode:
    opt text, active: bool) -> (Result_3);
   vatPreview: (from: Date, to: Date) -> (Result_2) query;
   /// First broken entry in [from, from + 5000), or null if intact.
   verifyAudit: (from: nat) -> (Result_1) query;
   vetkdPublicKey: () -> (Result);
   /// Keeps only what every replica sees the same way (V5: requestDate differs per call).
   viesTransform: (arg: TransformArg) -> (HttpResponse) query;
 };
type AccountKind = 
 variant {
   asset;
   equity;
   expense;
   liability;
   revenue;
 };
type Account = 
 record {
   active: bool;
   bas: bool;
   kind: AccountKind;
   name: text;
   number: nat;
   sruCode: opt text;
   vatCode: opt text;
 };
service : (firstOwner: opt principal) -> Accounting
