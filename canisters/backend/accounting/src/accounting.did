type VoucherView = 
 record {
   attachmentIds: vec nat;
   correctedBy: vec nat;
   corrects: opt nat;
   counterparty: opt text;
   createdBy: principal;
   description: text;
   eventDate: Date;
   fiscalYearId: nat;
   id: nat;
   lines: vec VoucherLine;
   linkedAttachments: vec nat;
   number: nat;
   registeredAt: Time;
   retainUntil: Date;
   series: text;
   source: SourceRef;
 };
type VoucherLine = 
 record {
   account: nat;
   amount: Money;
   costCenter: opt text;
   project: opt text;
   quantity: opt int;
   "text": opt text;
   vatCode: opt text;
 };
type VoucherInput = 
 record {
   attachmentIds: vec nat;
   counterparty: opt text;
   description: text;
   eventDate: Date;
   lines: vec VoucherLine;
   series: text;
 };
type VoucherDraft = 
 record {
   attachmentIds: vec nat;
   counterparty: opt text;
   description: text;
   eventDate: Date;
   id: nat;
   lines: vec VoucherLine;
   series: text;
   updatedAt: Time;
   updatedBy: principal;
 };
type Voucher = 
 record {
   attachmentIds: vec nat;
   corrects: opt nat;
   counterparty: opt text;
   createdBy: principal;
   description: text;
   eventDate: Date;
   fiscalYearId: nat;
   id: nat;
   lines: vec VoucherLine;
   number: nat;
