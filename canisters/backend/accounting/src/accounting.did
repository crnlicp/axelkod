 };
type SourceRef = 
 variant {
   asset: nat;
   bankTx: nat;
   creditNote: nat;
   inventory: nat;
   manual;
   payRun: nat;
   payment: nat;
   purchase: nat;
   rotRut: nat;
   salesInvoice: nat;
   taxAccount: nat;
   vatReturn: nat;
   yearEnd: nat;
 };
type Snapshot = 
 record {
   buyer: PartySnapshot;
   creditOf: opt record {
                   issueDate: Date;
                   number: nat;
                 };
   currency: text;
   deliveryDate: opt Date;
   dueDate: opt Date;
   fxRate: opt FxRate;
   issueDate: Date;
   kind: DocKind;
   language: Lang;
   lateInterestText: opt text;
   legalNotes: vec text;
   lines: vec SnapLine;
   notes: opt text;
   number: nat;
   ocr: opt text;
   ourRef: opt text;
   seller: CompanyProfile;
   templateVersion: text;
   termsDays: nat;
   total: Money;
   totalNet: Money;
   totalVat: Money;
   totalVatSek: opt Money;
   validUntil: opt Date;
   vat: vec VatRow;
   yourRef: opt text;
 };
type SnapLine = 
 record {
   account: nat;
