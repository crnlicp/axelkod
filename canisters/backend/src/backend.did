type Whoami = 
 record {
   isAdmin: bool;
   "principal": principal;
 };
type SubmitError = 
 variant {
   invalid: text;
   rateLimited;
   tokenExpired;
   tokenInvalid;
   tokenTooFast;
   tokenUsed;
   unavailable;
 };
type Status = 
 variant {
   handled;
   new;
   read;
 };
type SiteSettings = 
 record {
   responseTime: record {
                   en: text;
                   sv: text;
                 };
   retentionMonths: nat;
 };
type SeoState = 
 record {
   publishedAt: opt int;
   settings: SeoSettings;
   updatedAt: int;
 };
type SeoSettings = 
 record {
   bingVerification: opt text;
   en: SeoLang;
   googleVerification: opt text;
   logoUrl: text;
   organisationName: text;
   sameAs: vec text;
   sv: SeoLang;
 };
type SeoLang = 
 record {
   canonicalBaseUrl: text;
   indexable: bool;
   keywords: opt text;
   metaDescription: text;
   ogDescription: opt text;
   ogImageUrl: text;
   ogTitle: opt text;
   title: text;
 };
type Result_9 = 
 variant {
   err: Error;
   ok: vec AdminView;
 };
type Result_8 = 
 variant {
   err: Error;
   ok: MessagePage;
 };
type Result_7 = 
 variant {
   err: Error;
   ok: int;
 };
type Result_6 = 
 variant {
   err: Error;
   ok: ContactInfo;
 };
type Result_5 = 
 variant {
   err: Error;
   ok: SeoSettings;
 };
type Result_4 = 
 variant {
   err: Error;
   ok: SiteSettings;
 };
type Result_3 = 
 variant {
   err: Error;
   ok;
 };
type Result_2 = 
 variant {
   err: SubmitError;
   ok: nat;
 };
type Result_13 = 
 variant {
   err: Error;
   ok: vec News;
 };
type Result_12 = 
 variant {
   err: Error;
   ok: text;
 };
type Result_11 = 
 variant {
   err: SubmitError;
   ok: text;
 };
type Result_10 = 
 variant {
   err: Error;
   ok: SeoState;
 };
type Result_1 = 
 variant {
   err: Error;
   ok: record {
         authorized: nat;
         deauthorized: nat;
       };
 };
type Result = 
 variant {
   err: Error;
   ok: News;
 };
type PublicContact = 
 record {
   city: text;
   email: opt text;
   orgNumber: opt text;
   phone: opt text;
   postalCode: opt text;
   street: opt text;
 };
type PublicConfig = 
 record {
   contact: PublicContact;
   responseTime: record {
                   en: text;
                   sv: text;
                 };
   retentionMonths: nat;
   seo: SeoSettings;
 };
type PageRequest = 
 record {
   limit: nat;
   offset: nat;
 };
type NewsSummary = 
 record {
   area: opt NewsArea;
   coverAlt: text;
   coverUrl: opt text;
   excerpt: text;
   hasOtherLang: bool;
   publishedAt: int;
   slug: text;
   title: text;
 };
type NewsStatus = 
 variant {
   draft;
   published;
 };
type NewsPage = 
 record {
   items: vec NewsSummary;
   total: nat;
 };
type NewsLang = 
 record {
   body: text;
   coverAlt: text;
   excerpt: text;
   title: text;
 };
type NewsInput = 
 record {
   area: opt NewsArea;
   coverUrl: opt text;
   en: opt NewsLang;
   publishedAt: int;
   slug: text;
   status: NewsStatus;
   sv: NewsLang;
 };
type NewsArticle = 
 record {
   body: text;
   summary: NewsSummary;
 };
type NewsArea = 
 variant {
   company;
   parts;
   security;
   software;
 };
type News = 
 record {
   area: opt NewsArea;
   coverUrl: opt text;
   createdAt: int;
   en: opt NewsLang;
   id: nat;
   publishedAt: int;
   slug: text;
   status: NewsStatus;
   sv: NewsLang;
   updatedAt: int;
 };
type MessagePage = 
 record {
   items: vec Message;
   total: nat;
   unread: nat;
 };
type MessageFilter = 
 record {
   search: opt text;
   status: opt Status;
 };
type Message = 
 record {
   adminNote: opt text;
   area: Area;
   company: opt text;
   createdAt: int;
   email: text;
   id: nat;
   lang: Lang;
   message: text;
   name: text;
   phone: opt text;
   status: Status;
 };
type Lang = 
 variant {
   en;
   sv;
 };
type Error = 
 variant {
   conflict: text;
   frontend: text;
   invalid: text;
   lastAdmin;
   notAuthorized;
   notFound;
 };
type ContactInput = 
 record {
   area: Area;
   company: opt text;
   consent: bool;
   email: text;
   lang: Lang;
   message: text;
   name: text;
   phone: opt text;
   website: text;
 };
type ContactInfo = 
 record {
   city: text;
   email: text;
   orgNumber: opt text;
   phone: opt text;
   postalCode: opt text;
   showAddress: bool;
   showPhone: bool;
   street: opt text;
 };
type Backend = 
 service {
   addAdmin: (p: principal) -> (Result_3);
   adminListNews: () -> (Result_13) query;
   createNews: (input: NewsInput) -> (Result);
   deleteMessage: (id: nat) -> (Result_3);
   deleteNews: (id: nat) -> (Result_3);
   exportMessagesCsv: () -> (Result_12) query;
   getContactInfo: () -> (Result_6) query;
   getFormToken: (nonce: text) -> (Result_11) query;
   getNews: (slug: text, lang: Lang) -> (opt NewsArticle) query;
   getPublicConfig: () -> (PublicConfig) query;
   getSeoSettings: () -> (Result_10) query;
   getSiteSettings: () -> (Result_4) query;
   listAdmins: () -> (Result_9) query;
   listMessages: (filter: MessageFilter, page: PageRequest) ->
    (Result_8) query;
   listNews: (lang: Lang, offset: nat, limit: nat) -> (NewsPage) query;
   /// Called by the admin UI after Publish has written the SEO files to the frontend.
   markSeoPublished: () -> (Result_7);
   /// All published articles in both languages (public data), for baking pages.
   publishedNews: () -> (vec News) query;
   removeAdmin: (p: principal) -> (Result_3);
   /// Controller-only: clears the global rate-limit window, e.g. after a bot used up
   /// the daily quota (or between local test runs). Single-use tokens stay recorded.
   resetFormLimits: () -> (Result_3);
   setContactInfo: (c: ContactInfo) -> (Result_6);
   setNote: (id: nat, note: text) -> (Result_3);
   setSeoSettings: (s: SeoSettings) -> (Result_5);
   setSiteSettings: (s: SiteSettings) -> (Result_4);
   setStatus: (id: nat, status: Status) -> (Result_3);
   submitContact: (input: ContactInput, token: text) -> (Result_2);
   /// Makes the frontend's authorized set equal the admin set. Run after deploys:
   /// a frontend reinstall wipes its authorized list.
   syncAdminsToFrontend: () -> (Result_1);
   updateNews: (id: nat, input: NewsInput) -> (Result);
   whoami: () -> (Whoami) query;
 };
type Area = 
 variant {
   other;
   parts;
   security;
   software;
 };
type AdminView = 
 record {
   addedAt: int;
   "principal": principal;
 };
service : (firstAdmin: opt principal) -> Backend
