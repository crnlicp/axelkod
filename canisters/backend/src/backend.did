type Whoami = 
 record {
   isAdmin: bool;
   "principal": principal;
 };
type SubmitError = 
 variant {
   invalid: text;
   rateLimited;
   tokenExpired;
   tokenInvalid;
   tokenTooFast;
   tokenUsed;
   unavailable;
 };
type Status = 
 variant {
   handled;
   new;
   read;
 };
type SiteSettings = 
 record {
   responseTime: record {
                   en: text;
                   sv: text;
                 };
   retentionMonths: nat;
 };
type SeoState = 
 record {
   publishedAt: opt int;
   settings: SeoSettings;
   updatedAt: int;
 };
type SeoSettings = 
 record {
   bingVerification: opt text;
   en: SeoLang;
   googleVerification: opt text;
   logoUrl: text;
   organisationName: text;
   sameAs: vec text;
   sv: SeoLang;
 };
type SeoLang = 
 record {
   canonicalBaseUrl: text;
   indexable: bool;
   keywords: opt text;
   metaDescription: text;
   ogDescription: opt text;
   ogImageUrl: text;
   ogTitle: opt text;
   title: text;
 };
type Result_9 = 
 variant {
   err: SubmitError;
   ok: text;
 };
type Result_8 = 
 variant {
   err: Error;
   ok: SeoState;
 };
type Result_7 = 
 variant {
   err: Error;
   ok: vec AdminView;
 };
type Result_6 = 
 variant {
   err: Error;
   ok: MessagePage;
 };
type Result_5 = 
 variant {
   err: Error;
   ok: ContactInfo;
 };
type Result_4 = 
 variant {
   err: Error;
   ok: SeoSettings;
 };
type Result_3 = 
 variant {
   err: Error;
   ok: SiteSettings;
 };
type Result_2 = 
 variant {
   err: Error;
   ok;
 };
type Result_10 = 
 variant {
   err: Error;
   ok: text;
 };
type Result_1 = 
 variant {
   err: SubmitError;
   ok: nat;
 };
type Result = 
 variant {
   err: Error;
   ok: record {
         authorized: nat;
         deauthorized: nat;
       };
 };
type PublicContact = 
 record {
   city: text;
   email: opt text;
   orgNumber: opt text;
   phone: opt text;
   postalCode: opt text;
   street: opt text;
 };
type PublicConfig = 
 record {
   contact: PublicContact;
   responseTime: record {
                   en: text;
                   sv: text;
                 };
   retentionMonths: nat;
   seo: SeoSettings;
 };
type PageRequest = 
 record {
   limit: nat;
   offset: nat;
 };
type MessagePage = 
 record {
   items: vec Message;
   total: nat;
   unread: nat;
 };
type MessageFilter = 
 record {
   search: opt text;
   status: opt Status;
 };
type Message = 
 record {
   adminNote: opt text;
   area: Area;
   company: opt text;
   createdAt: int;
   email: text;
   id: nat;
   lang: Lang;
   message: text;
   name: text;
   phone: opt text;
   status: Status;
 };
type Lang = 
 variant {
   en;
   sv;
 };
type Error = 
 variant {
   frontend: text;
   invalid: text;
   lastAdmin;
   notAuthorized;
   notFound;
 };
type ContactInput = 
 record {
   area: Area;
   company: opt text;
   consent: bool;
   email: text;
   lang: Lang;
   message: text;
   name: text;
   phone: opt text;
   website: text;
 };
type ContactInfo = 
 record {
   city: text;
   email: text;
   orgNumber: opt text;
   phone: opt text;
   postalCode: opt text;
   showAddress: bool;
   showPhone: bool;
   street: opt text;
 };
type Backend = 
 service {
   addAdmin: (p: principal) -> (Result_2);
   deleteMessage: (id: nat) -> (Result_2);
   exportMessagesCsv: () -> (Result_10) query;
   getContactInfo: () -> (Result_5) query;
   getFormToken: (nonce: text) -> (Result_9) query;
   getPublicConfig: () -> (PublicConfig) query;
   getSeoSettings: () -> (Result_8) query;
   getSiteSettings: () -> (Result_3) query;
   listAdmins: () -> (Result_7) query;
   listMessages: (filter: MessageFilter, page: PageRequest) ->
    (Result_6) query;
   removeAdmin: (p: principal) -> (Result_2);
   setContactInfo: (c: ContactInfo) -> (Result_5);
   setNote: (id: nat, note: text) -> (Result_2);
   setSeoSettings: (s: SeoSettings) -> (Result_4);
   setSiteSettings: (s: SiteSettings) -> (Result_3);
   setStatus: (id: nat, status: Status) -> (Result_2);
   submitContact: (input: ContactInput, token: text) -> (Result_1);
   /// Makes the frontend's authorized set equal the admin set. Run after deploys:
   /// a frontend reinstall wipes its authorized list.
   syncAdminsToFrontend: () -> (Result);
   whoami: () -> (Whoami) query;
 };
type Area = 
 variant {
   other;
   parts;
   security;
   software;
 };
type AdminView = 
 record {
   addedAt: int;
   "principal": principal;
 };
service : (firstAdmin: opt principal) -> Backend
