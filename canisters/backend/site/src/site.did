type Whoami = 
 record {
   isAdmin: bool;
   "principal": principal;
 };
type SubmitError = 
 variant {
   invalid: text;
   rateLimited;
   tokenExpired;
   tokenInvalid;
   tokenTooFast;
   tokenUsed;
   unavailable;
 };
type Status = 
 variant {
   handled;
   new;
   read;
 };
type SiteSettings = 
 record {
   responseTime: record {
                   en: text;
                   sv: text;
                 };
   retentionMonths: nat;
 };
type SeoState = 
 record {
   publishedAt: opt int;
   settings: SeoSettings;
   updatedAt: int;
 };
type SeoSettings = 
 record {
   bingVerification: opt text;
   en: SeoLang;
   googleVerification: opt text;
   logoUrl: text;
   organisationName: text;
   sameAs: vec text;
   sv: SeoLang;
 };
type SeoLang = 
 record {
   canonicalBaseUrl: text;
   indexable: bool;
   keywords: opt text;
   metaDescription: text;
   ogDescription: opt text;
   ogImageUrl: text;
   ogTitle: opt text;
   title: text;
 };
type Result_9 = 
 variant {
   err: Error;
   ok: ContactInfo;
 };
type Result_8 = 
 variant {
   err: Error;
   ok: HomeHero;
 };
type Result_7 = 
 variant {
   err: Error;
   ok: ProductSection;
 };
type Result_6 = 
 variant {
   err: Error;
   ok: HomeSection;
 };
type Result_5 = 
 variant {
   err: Error;
   ok: SeoSettings;
 };
type Result_4 = 
 variant {
   err: Error;
   ok: SiteSettings;
 };
type Result_3 = 
 variant {
   err: Error;
   ok;
 };
type Result_2 = 
 variant {
   err: SubmitError;
   ok: nat;
 };
type Result_17 = 
 variant {
   err: Error;
   ok: HomeContent;
 };
type Result_16 = 
 variant {
   err: Error;
   ok: vec News;
 };
type Result_15 = 
 variant {
   err: Error;
   ok: text;
 };
type Result_14 = 
 variant {
   err: SubmitError;
   ok: text;
 };
type Result_13 = 
 variant {
   err: Error;
   ok: SeoState;
 };
type Result_12 = 
 variant {
   err: Error;
   ok: vec AdminView;
 };
type Result_11 = 
 variant {
   err: Error;
   ok: MessagePage;
 };
type Result_10 = 
 variant {
   err: Error;
   ok: int;
 };
type Result_1 = 
 variant {
   err: Error;
   ok: record {
         authorized: nat;
         deauthorized: nat;
       };
 };
type Result = 
 variant {
   err: Error;
   ok: News;
 };
type PublicContact = 
 record {
   city: text;
   email: opt text;
   mapLat: opt float64;
   mapLon: opt float64;
   mapUrl: opt text;
   orgNumber: opt text;
   phone: opt text;
   postalCode: opt text;
   street: opt text;
 };
type PublicConfig = 
 record {
   contact: PublicContact;
   responseTime: record {
                   en: text;
                   sv: text;
                 };
   retentionMonths: nat;
   seo: SeoSettings;
 };
type ProductText = 
 record {
   cta: text;
   "text": text;
   title: text;
 };
type ProductStatus = 
 variant {
   beta;
   live;
   soon;
 };
type ProductSection = 
 record {
   en: HomeHead;
   items: vec ProductItem;
   sv: HomeHead;
 };
type ProductItem = 
 record {
   background: text;
   en: ProductText;
   icon: text;
   status: ProductStatus;
   sv: ProductText;
   url: text;
 };
type PageRequest = 
 record {
   limit: nat;
   offset: nat;
 };
type NewsSummary = 
 record {
   area: opt NewsArea;
   coverAlt: text;
   coverUrl: opt text;
   excerpt: text;
   hasOtherLang: bool;
   publishedAt: int;
   slug: text;
   title: text;
 };
type NewsStatus = 
 variant {
   draft;
   published;
 };
type NewsPage = 
 record {
   items: vec NewsSummary;
   total: nat;
 };
type NewsLang = 
 record {
   body: text;
   coverAlt: text;
   excerpt: text;
   title: text;
 };
type NewsInput = 
 record {
   area: opt NewsArea;
   coverUrl: opt text;
   en: opt NewsLang;
   publishedAt: int;
   slug: text;
   status: NewsStatus;
   sv: NewsLang;
 };
type NewsArticle = 
 record {
   body: text;
   summary: NewsSummary;
 };
type NewsArea = 
 variant {
   company;
   parts;
   security;
   software;
 };
type News = 
 record {
   area: opt NewsArea;
   coverUrl: opt text;
   createdAt: int;
   en: opt NewsLang;
   id: nat;
   publishedAt: int;
   slug: text;
   status: NewsStatus;
   sv: NewsLang;
   updatedAt: int;
 };
type MessagePage = 
 record {
   items: vec Message;
   total: nat;
   unread: nat;
 };
type MessageFilter = 
 record {
   search: opt text;
   status: opt Status;
 };
type Message = 
 record {
   adminNote: opt text;
   area: Area;
   company: opt text;
   createdAt: int;
   email: text;
   id: nat;
   lang: Lang;
   message: text;
   name: text;
   phone: opt text;
   status: Status;
 };
type Lang = 
 variant {
   en;
   sv;
 };
type HomeText = 
 record {
   "text": text;
   title: text;
 };
type HomeSection = 
 record {
   en: HomeHead;
   items: vec HomeItem;
   sv: HomeHead;
 };
type HomeKey = 
 variant {
   industries;
   security;
   services;
 };
type HomeItem = 
 record {
   en: HomeText;
   icon: text;
   sv: HomeText;
   visual: text;
 };
type HomeHero = 
 record {
   ciphers: vec nat;
   en: HeroLang;
   highlights: vec nat;
   sv: HeroLang;
   trust: vec HomeItem;
   visuals: HeroVisuals;
 };
type HomeHead = 
 record {
   eyebrow: text;
   intro: text;
   title: text;
 };
type HomeContent = 
 record {
   hero: HomeHero;
   industries: HomeSection;
   products: ProductSection;
   security: HomeSection;
   services: HomeSection;
 };
type HeroVisuals = 
 record {
   beacon: record {
             lat: float64;
             lon: float64;
           };
   globe: bool;
   globeSize: nat;
   logo: bool;
   logoDepth: nat;
   logoInGlobe: bool;
   network: bool;
 };
type HeroLang = 
 record {
   cta: text;
   cta2: text;
   eyebrow: text;
   subtitle: text;
   words: vec text;
 };
type Error = 
 variant {
   conflict: text;
   frontend: text;
   invalid: text;
   lastAdmin;
   notAuthorized;
   notFound;
 };
type ContactInput = 
 record {
   area: Area;
   company: opt text;
   consent: bool;
   email: text;
   lang: Lang;
   message: text;
   name: text;
   phone: opt text;
   website: text;
 };
type ContactInfo = 
 record {
   city: text;
   email: text;
   mapLat: opt float64;
   mapLon: opt float64;
   mapUrl: opt text;
   orgNumber: opt text;
   phone: opt text;
   postalCode: opt text;
   showAddress: bool;
   showPhone: bool;
   street: opt text;
 };
type Backend = 
 service {
   addAdmin: (p: principal) -> (Result_3);
   adminGetHome: () -> (Result_17) query;
   adminListNews: () -> (Result_16) query;
   createNews: (input: NewsInput) -> (Result);
   deleteMessage: (id: nat) -> (Result_3);
   deleteNews: (id: nat) -> (Result_3);
   exportMessagesCsv: () -> (Result_15) query;
   getContactInfo: () -> (Result_9) query;
   getFormToken: (nonce: text) -> (Result_14) query;
   /// The published sections, as baked into the site.
   getHome: () -> (HomeContent) query;
   getNews: (slug: text, lang: Lang) -> (opt NewsArticle) query;
   getPublicConfig: () -> (PublicConfig) query;
   getSeoSettings: () -> (Result_13) query;
   getSiteSettings: () -> (Result_4) query;
   listAdmins: () -> (Result_12) query;
   listMessages: (filter: MessageFilter, page: PageRequest) ->
    (Result_11) query;
   listNews: (lang: Lang, offset: nat, limit: nat) -> (NewsPage) query;
   /// Called by the admin UI after Publish has written the SEO files to the frontend.
   markSeoPublished: () -> (Result_10);
   /// All published articles in both languages (public data), for baking pages.
   publishedNews: () -> (vec News) query;
   removeAdmin: (p: principal) -> (Result_3);
   /// Controller-only: clears the global rate-limit window, e.g. after a bot used up
   /// the daily quota (or between local test runs). Single-use tokens stay recorded.
   resetFormLimits: () -> (Result_3);
   setContactInfo: (c: ContactInfo) -> (Result_9);
   setHomeHero: (hero: HomeHero) -> (Result_8);
   setHomeProducts: (section: ProductSection) -> (Result_7);
   /// One section per call keeps each request well under the ingress size limit.
   setHomeSection: (key: HomeKey, section: HomeSection) -> (Result_6);
   setNote: (id: nat, note: text) -> (Result_3);
   setSeoSettings: (s: SeoSettings) -> (Result_5);
   setSiteSettings: (s: SiteSettings) -> (Result_4);
   setStatus: (id: nat, status: Status) -> (Result_3);
   submitContact: (input: ContactInput, token: text) -> (Result_2);
   /// Makes the frontend's authorized set equal the admin set. Run after deploys:
   /// a frontend reinstall wipes its authorized list.
   syncAdminsToFrontend: () -> (Result_1);
   updateNews: (id: nat, input: NewsInput) -> (Result);
   whoami: () -> (Whoami) query;
 };
type Area = 
 variant {
   other;
   parts;
   security;
   software;
 };
type AdminView = 
 record {
   addedAt: int;
   "principal": principal;
 };
service : (firstAdmin: opt principal) -> Backend
